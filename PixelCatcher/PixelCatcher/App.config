<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup> 
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!-- Amiga Easter Egg Runner: Set to true to enable, false to turn off -->
    <add key="EasterEggEnabled" value="true" />
    <!-- Character: "Zool" or "Superfrog" -->
    <add key="EasterEggCharacter" value="Zool" />
    <!-- Frequency in seconds between runs (e.g. 120 = 2 minutes). Set to 0 to only trigger via hotkey -->
    <add key="EasterEggIntervalSeconds" value="120" />
    <!-- Run speed in pixels per frame (default: 5) -->
    <add key="EasterEggSpeed" value="5" />
  </appSettings>
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
